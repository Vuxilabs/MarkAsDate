---
---

<aside class="day-panel" aria-labelledby="day-heading">
	<a class="brand" href="/" aria-label="NLFTs co., Ltd beranda">
		<span class="brand-mark" aria-hidden="true">N</span>
		<span>NLFTs, Ltd</span>
	</a>

	<div class="day-panel-header">
		<div>
			<h2 id="day-heading"></h2>
		</div>
		<span id="agenda-count" class="count-badge">0</span>
	</div>

	<div id="day-agendas" class="day-agendas"></div>

	<div id="empty-day" class="empty-day">
		<strong>Hari masih kosong</strong>
	</div>

	<section class="markdown-section" aria-labelledby="markdown-heading">
		<div class="section-heading markdown-heading">
			<div>
				<h2 id="markdown-heading">Markdown</h2>
			</div>
			<button class="copy-button" id="copy-markdown" type="button" aria-label="Salin Markdown">
				Salin
			</button>
		</div>
		<pre id="markdown-output" class="markdown-output" aria-label="Hasil Markdown"></pre>
	</section>
</aside>

