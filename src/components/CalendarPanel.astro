---
---

<section class="calendar-panel" aria-label="Kalender agenda">
	<header class="calendar-header">
		<div class="month-controls">
			<!-- Custom month picker -->
			<div class="custom-month-picker" id="custom-month-picker">
				<button
					type="button"
					class="month-picker-trigger"
					id="month-picker-trigger"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-label="Pilih bulan"
				>
					<span id="month-display">Oktober</span>
					<svg class="month-chevron" viewBox="0 0 16 16" aria-hidden="true" fill="none">
						<path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<div class="month-dropdown" id="month-dropdown" role="listbox" aria-label="Pilih bulan" hidden>
					<div class="month-grid">
						<button type="button" role="option" class="month-option" data-month="0">Jan</button>
						<button type="button" role="option" class="month-option" data-month="1">Feb</button>
						<button type="button" role="option" class="month-option" data-month="2">Mar</button>
						<button type="button" role="option" class="month-option" data-month="3">Apr</button>
						<button type="button" role="option" class="month-option" data-month="4">Mei</button>
						<button type="button" role="option" class="month-option" data-month="5">Jun</button>
						<button type="button" role="option" class="month-option" data-month="6">Jul</button>
						<button type="button" role="option" class="month-option" data-month="7">Ags</button>
						<button type="button" role="option" class="month-option" data-month="8">Sep</button>
						<button type="button" role="option" class="month-option" data-month="9">Okt</button>
						<button type="button" role="option" class="month-option" data-month="10">Nov</button>
						<button type="button" role="option" class="month-option" data-month="11">Des</button>
					</div>
				</div>
			</div>

			<!-- Custom year picker -->
			<div class="custom-year-picker">
				<button type="button" class="year-step-btn" id="year-down" aria-label="Tahun sebelumnya">‹</button>
				<input
					type="number"
					id="year-input"
					class="year-input"
					value="2026"
					min="1900"
					max="9999"
					aria-label="Tahun"
				/>
				<button type="button" class="year-step-btn" id="year-up" aria-label="Tahun berikutnya">›</button>
			</div>
		</div>

		<div class="calendar-navigation">
			<button id="previous-month" class="icon-button" type="button" aria-label="Bulan sebelumnya">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
			</button>
			<button id="next-month" class="icon-button" type="button" aria-label="Bulan berikutnya">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
			</button>
		</div>
	</header>

	<div class="weekdays" aria-hidden="true">
		<span>Min</span><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span>
	</div>

	<div id="calendar-grid" class="calendar-grid" role="grid" aria-label="Tanggal bulan ini"></div>

	<div class="calendar-legend">
		<span><i class="legend-dot marked-legend"></i> Ada agenda</span>
		<span><i class="legend-dot selected-legend"></i> Dipilih</span>
		<span><i class="legend-dot today-legend"></i> Hari ini</span>
	</div>
</section>
