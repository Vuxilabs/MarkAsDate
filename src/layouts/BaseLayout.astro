---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'MarkAsDate — kalender agenda nlfts co., Ltd',
	description = 'Tandai jadwal dan buat catatan agenda dalam format Markdown.',
} = Astro.props;
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#000000" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

