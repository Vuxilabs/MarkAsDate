---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#000000" />
		<meta name="description" content="Tandai jadwal dan buat catatan agenda dalam format Markdown." />
		<title>MarkAsDate — kalender agenda</title>
	</head>
	<body>
		<main class="app-shell">
			<aside class="sidebar">
				<section class="entry-section" aria-labelledby="entry-heading">
					<div class="section-heading">
						<div>
							<h2 id="entry-heading">Tambah jadwal</h2>
						</div>
						<span class="date-chip" id="selected-date-chip"></span>
					</div>
					<form id="agenda-form">
						<label for="agenda-title">Nama agenda</label>
						<input id="agenda-title" name="title" type="text" maxlength="120" placeholder="Contoh: Meeting dengan klien" required />
						<label for="agenda-time">Jam</label>
						<input id="agenda-time" name="time" type="time" value="09:00" required />
						<button class="add-button" type="submit">
							<span aria-hidden="true">+</span> Tandai tanggal
						</button>
					</form>
					<p class="form-status" id="form-status" role="status" aria-live="polite"></p>
				</section>

			</aside>

			<section class="calendar-panel" aria-label="Kalender agenda">
				<header class="calendar-header">
					<div class="month-controls">
						<select id="month-select" aria-label="Pilih bulan">
							<option value="0">Januari</option>
							<option value="1">Februari</option>
							<option value="2">Maret</option>
							<option value="3">April</option>
							<option value="4">Mei</option>
							<option value="5">Juni</option>
							<option value="6">Juli</option>
							<option value="7">Agustus</option>
							<option value="8">September</option>
							<option value="9">Oktober</option>
							<option value="10">November</option>
							<option value="11">Desember</option>
						</select>
						<input id="year-select" class="year-select" type="number" min="1900" max="9999" step="1" aria-label="Pilih tahun" />
					</div>
					<div class="calendar-navigation">
						<button id="previous-month" class="icon-button" type="button" aria-label="Bulan sebelumnya">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
						</button>
						<button id="next-month" class="icon-button" type="button" aria-label="Bulan berikutnya">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
						</button>
					</div>
				</header>

				<div class="weekdays" aria-hidden="true">
					<span>Min</span><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span>
				</div>
				<div id="calendar-grid" class="calendar-grid" role="grid" aria-label="Tanggal bulan ini"></div>
				<div class="calendar-legend">
					<span><i class="legend-dot marked"></i> Ada agenda</span>
					<span><i class="legend-dot selected-legend"></i> Dipilih</span>
					<span><i class="legend-dot today-legend"></i> Hari ini</span>
				</div>
			</section>

			<aside class="day-panel" aria-labelledby="day-heading">
				<a class="brand" href="/" aria-label="MarkAsDate beranda">
					<span class="brand-mark" aria-hidden="true">M</span>
					<span>MarkAsDate</span>
				</a>
				<div class="day-panel-header">
					<div>
						<h2 id="day-heading"></h2>
					</div>
					<span id="agenda-count" class="count-badge">0</span>
				</div>
				<div id="day-agendas" class="day-agendas"></div>
				<div id="empty-day" class="empty-day">
					<strong>Hari masih kosong</strong>
				</div>
				<section class="markdown-section" aria-labelledby="markdown-heading">
					<div class="section-heading markdown-heading">
						<div>
							<h2 id="markdown-heading">Markdown</h2>
						</div>
						<button class="copy-button" id="copy-markdown" type="button" aria-label="Salin Markdown">Salin</button>
					</div>
					<pre id="markdown-output" class="markdown-output" aria-label="Hasil Markdown"></pre>
				</section>
			</aside>
		</main>

		<script>
			type Agenda = {
				id: string;
				date: string;
				title: string;
				time: string;
			};

			const STORAGE_KEY = 'mark-as-date-agendas';
			const now = new Date();
			let selectedDate = toDateKey(now);
			let visibleYear = now.getFullYear();
			let visibleMonth = now.getMonth();

			const monthSelect = document.querySelector('#month-select') as HTMLSelectElement;
			const yearSelect = document.querySelector('#year-select') as HTMLInputElement;
			const calendarGrid = document.querySelector('#calendar-grid') as HTMLElement;
			const dayHeading = document.querySelector('#day-heading') as HTMLElement;
			const selectedDateChip = document.querySelector('#selected-date-chip') as HTMLElement;
			const dayAgendas = document.querySelector('#day-agendas') as HTMLElement;
			const emptyDay = document.querySelector('#empty-day') as HTMLElement;
			const agendaCount = document.querySelector('#agenda-count') as HTMLElement;
			const markdownOutput = document.querySelector('#markdown-output') as HTMLElement;
			const form = document.querySelector('#agenda-form') as HTMLFormElement;
			const titleInput = document.querySelector('#agenda-title') as HTMLInputElement;
			const timeInput = document.querySelector('#agenda-time') as HTMLInputElement;
			const formStatus = document.querySelector('#form-status') as HTMLElement;
			let agendas = loadAgendas();

			function toDateKey(date: Date) {
				const year = date.getFullYear();
				const month = String(date.getMonth() + 1).padStart(2, '0');
				const day = String(date.getDate()).padStart(2, '0');
				return `${year}-${month}-${day}`;
			}

			function loadAgendas(): Agenda[] {
				try {
					const saved = sessionStorage.getItem(STORAGE_KEY);
					if (!saved) return [];
					const parsed: unknown = JSON.parse(saved);
					if (!Array.isArray(parsed) || !parsed.every((item) =>
						item && typeof item.id === 'string' && typeof item.date === 'string' &&
						typeof item.title === 'string' && typeof item.time === 'string'
					)) {
						throw new Error('Format data agenda tidak valid.');
					}
					return parsed as Agenda[];
				} catch (error) {
					console.error('Gagal membaca agenda dari sesi browser:', error);
					formStatus.textContent = 'Agenda sesi sebelumnya tidak dapat dibaca.';
					return [];
				}
			}

			function changeMonth(offset: number) {
				const nextMonth = new Date(visibleYear, visibleMonth + offset, 1);
				setVisibleMonth(nextMonth.getFullYear(), nextMonth.getMonth());
			}

			function setVisibleMonth(year: number, month: number) {
				if (year < 1900 || year > 9999) {
					formStatus.textContent = 'Tahun kalender tersedia antara 1900 dan 9999.';
					return;
				}
				visibleYear = year;
				visibleMonth = month;
				const day = Number(selectedDate.split('-')[2]);
				const lastDay = new Date(visibleYear, visibleMonth + 1, 0).getDate();
				selectedDate = toDateKey(new Date(visibleYear, visibleMonth, Math.min(day, lastDay)));
				formStatus.textContent = '';
				render();
			}

			function persistAgendas() {
				try {
					sessionStorage.setItem(STORAGE_KEY, JSON.stringify(agendas));
					formStatus.textContent = '';
				} catch (error) {
					console.error('Gagal menyimpan agenda ke sesi browser:', error);
					formStatus.textContent = 'Agenda tidak dapat disimpan di sesi browser.';
				}
			}

			function formatDate(dateKey: string, options: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long', year: 'numeric' }) {
				const [year, month, day] = dateKey.split('-').map(Number);
				return new Intl.DateTimeFormat('id-ID', options).format(new Date(year, month - 1, day));
			}

			function escapeHtml(value: string) {
				return value.replace(/[&<>"']/g, (character) => ({
					'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
				})[character] ?? character);
			}

			function renderCalendar() {
				monthSelect.value = String(visibleMonth);
				yearSelect.value = String(visibleYear);
				const firstDay = new Date(visibleYear, visibleMonth, 1).getDay();
				const daysInMonth = new Date(visibleYear, visibleMonth + 1, 0).getDate();
				const markedDates = new Set(agendas.map((agenda) => agenda.date));
				const today = toDateKey(new Date());
				const cells = Array.from({ length: firstDay }, () => '<div class="day-cell empty-cell" aria-hidden="true"></div>');

				for (let day = 1; day <= daysInMonth; day++) {
					const dateKey = toDateKey(new Date(visibleYear, visibleMonth, day));
					const isSelected = dateKey === selectedDate;
					const isMarked = markedDates.has(dateKey);
					const isToday = dateKey === today;
					const isSunday = new Date(visibleYear, visibleMonth, day).getDay() === 0;
					const classes = ['day-cell', isSelected ? 'selected' : '', isMarked ? 'marked' : '', isToday ? 'today' : '', isSunday ? 'sunday' : ''].filter(Boolean).join(' ');
					const agendaLabel = isMarked ? ', ada agenda' : '';
					const todayLabel = isToday ? ', hari ini' : '';
					cells.push(`<button class="${classes}" type="button" role="gridcell" data-date="${dateKey}" aria-label="${day} ${formatDate(dateKey, { month: 'long', year: 'numeric' })}${agendaLabel}${todayLabel}" aria-pressed="${isSelected}"><span>${day}</span>${isMarked ? '<i class="day-dot" aria-hidden="true"></i>' : isToday ? '<i class="today-dot" aria-hidden="true"></i>' : ''}</button>`);
				}

				calendarGrid.innerHTML = cells.join('');
				calendarGrid.querySelectorAll<HTMLButtonElement>('[data-date]').forEach((button) => {
					button.addEventListener('click', () => {
						selectedDate = button.dataset.date!;
						render();
					});
				});
			}

			function renderDay() {
				dayHeading.textContent = formatDate(selectedDate, { weekday: 'short', day: 'numeric', month: 'short' });
				selectedDateChip.textContent = formatDate(selectedDate, { day: 'numeric', month: 'short' });
				const selectedAgendas = agendas
					.filter((agenda) => agenda.date === selectedDate)
					.sort((first, second) => first.time.localeCompare(second.time));

				agendaCount.textContent = String(selectedAgendas.length);
				emptyDay.hidden = selectedAgendas.length > 0;
				dayAgendas.innerHTML = selectedAgendas.map((agenda) => `
					<article class="agenda-card">
						<div class="agenda-time"><span class="time-dot"></span>${escapeHtml(agenda.time)}</div>
						<p>${escapeHtml(agenda.title)}</p>
						<button class="delete-button" type="button" data-delete="${escapeHtml(agenda.id)}" aria-label="Hapus agenda ${escapeHtml(agenda.title)}">×</button>
					</article>
				`).join('');
				dayAgendas.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) => {
					button.addEventListener('click', () => {
						agendas = agendas.filter((agenda) => agenda.id !== button.dataset.delete);
						persistAgendas();
						render();
					});
				});
			}

			function renderMarkdown() {
				const byDate = new Map<string, Agenda[]>();
				for (const agenda of agendas) {
					const dayAgendas = byDate.get(agenda.date) ?? [];
					dayAgendas.push(agenda);
					byDate.set(agenda.date, dayAgendas);
				}

				const markdown = [...byDate.entries()]
					.sort(([first], [second]) => first.localeCompare(second))
					.map(([date, entries]) => {
						const bullets = entries
							.sort((first, second) => first.time.localeCompare(second.time))
							.map((agenda) => `- ${agenda.title} pukul : ${agenda.time}`)
							.join('\n');
						return `## ${formatDate(date).toLocaleLowerCase('id-ID')}\n${bullets}`;
					})
					.join('\n\n');
				markdownOutput.textContent = markdown || 'Agenda yang kamu tandai akan muncul di sini.';
				markdownOutput.classList.toggle('placeholder', markdown.length === 0);
			}

			function render() {
				renderCalendar();
				renderDay();
				renderMarkdown();
			}

			document.querySelector('#previous-month')?.addEventListener('click', () => {
				changeMonth(-1);
			});

			document.querySelector('#next-month')?.addEventListener('click', () => {
				changeMonth(1);
			});

			monthSelect.addEventListener('change', () => {
				setVisibleMonth(visibleYear, Number(monthSelect.value));
			});

			yearSelect.addEventListener('change', () => {
				const year = Number(yearSelect.value);
				if (!Number.isInteger(year) || year < 1900 || year > 9999) {
					formStatus.textContent = 'Masukkan tahun antara 1900 dan 9999.';
					yearSelect.value = String(visibleYear);
					return;
				}
				setVisibleMonth(year, visibleMonth);
			});

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				const title = titleInput.value.trim();
				if (!title || !timeInput.value) return;
				agendas.push({
					id: globalThis.crypto.randomUUID(),
					date: selectedDate,
					title,
					time: timeInput.value,
				});
				persistAgendas();
				titleInput.value = '';
				render();
				titleInput.focus();
			});

			document.querySelector('#copy-markdown')?.addEventListener('click', async (event) => {
				const button = event.currentTarget as HTMLButtonElement;
				const markdown = markdownOutput.classList.contains('placeholder') ? '' : markdownOutput.textContent ?? '';
				if (!markdown) {
					formStatus.textContent = 'Belum ada Markdown untuk disalin.';
					return;
				}
				try {
					await navigator.clipboard.writeText(markdown);
					button.textContent = 'Tersalin';
					window.setTimeout(() => { button.textContent = 'Salin'; }, 1600);
				} catch (error) {
					console.error('Gagal menyalin Markdown:', error);
					formStatus.textContent = 'Markdown tidak dapat disalin dari browser ini.';
				}
			});

			render();
		</script>

		<style is:global>
			:root {
				color-scheme: dark;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				font-synthesis: none;
				text-rendering: optimizeLegibility;
				-webkit-font-smoothing: antialiased;
				--bg: #000000;
				--panel: #0a0a0a;
				--panel-soft: #141414;
				--line: #292929;
				--muted: #898989;
				--text: #f5f5f5;
				--accent: #ffffff;
				--accent-soft: #dedede;
			}

			* { box-sizing: border-box; }
			body {
				margin: 0;
				min-width: 320px;
				min-height: 100vh;
				background: var(--bg);
				color: var(--text);
			}
			button, input { font: inherit; }
			button { color: inherit; }
			.app-shell {
				width: min(1180px, calc(100% - 48px));
				height: min(760px, calc(100vh - 48px));
				margin: 24px auto;
				display: grid;
				grid-template-columns: minmax(270px, 0.9fr) minmax(0, 1.8fr) minmax(270px, 0.9fr);
				grid-template-areas: "details calendar form";
				background: var(--panel);
				border: 1px solid #262626;
				border-radius: 18px;
				overflow: hidden;
				box-shadow: 0 24px 90px #0004;
			}
			.sidebar, .calendar-panel, .day-panel { min-width: 0; min-height: 0; }
			.sidebar {
				grid-area: form;
				display: flex;
				flex-direction: column;
				padding: 24px 22px 20px;
				border-left: 1px solid var(--line);
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 11px;
				width: fit-content;
				color: var(--text);
				text-decoration: none;
				font-size: 14px;
				font-weight: 700;
				letter-spacing: -.02em;
			}
			.brand-mark {
				display: grid;
				place-items: center;
				width: 30px;
				height: 30px;
				border-radius: 10px;
				background: var(--accent);
				color: #000000;
				font-size: 16px;
				font-weight: 850;
			}
			.entry-section { margin-top: 28px; }
			.entry-section { padding-bottom: 23px; border-bottom: 1px solid var(--line); }
			.calendar-panel { grid-area: calendar; }
			.day-panel { grid-area: details; }
			.section-heading, .calendar-header, .day-panel-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 14px;
			}
			.section-heading .eyebrow, .day-panel-header .eyebrow { margin-bottom: 5px; }
			.section-heading h2, .day-panel-header h2 {
				margin: 0;
				font-size: 17px;
				letter-spacing: -.035em;
			}
			.date-chip {
				padding: 7px 9px;
				border: 1px solid #303030;
				border-radius: 8px;
				color: #c9c9c9;
				font-size: 10px;
				white-space: nowrap;
			}
			form { display: grid; gap: 8px; margin-top: 18px; }
			form label { margin-top: 4px; color: #aeaeae; font-size: 11px; font-weight: 600; }
			form input {
				width: 100%;
				height: 42px;
				padding: 0 2px;
				border: 0;
				border-bottom: 1px solid #4a4a4a;
				border-radius: 0;
				outline: none;
				background: transparent;
				color: var(--text);
				font-size: 12px;
				transition: border-color .16s;
			}
			form input::placeholder { color: #686868; }
			form input:focus { border-bottom-color: #ffffff; }
			.add-button {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 8px;
				height: 42px;
				margin-top: 5px;
				border: 0;
				border-radius: 9px;
				background: var(--accent);
				color: #000000;
				font-size: 12px;
				font-weight: 750;
				cursor: pointer;
				transition: background .16s, transform .16s;
			}
			.add-button:hover { background: var(--accent-soft); transform: translateY(-1px); }
			.add-button span { font-size: 19px; line-height: 0; font-weight: 500; }
			.form-status { min-height: 13px; margin: 8px 0 -5px; color: #b8b8b8; font-size: 10px; }
			.markdown-section { min-height: 0; padding-top: 22px; }
			.markdown-heading h2 { font-size: 16px; }
			.copy-button {
				padding: 6px 10px;
				border: 1px solid #343434;
				border-radius: 7px;
				background: transparent;
				color: #c4c4c4;
				font-size: 10px;
				cursor: pointer;
			}
			.copy-button:hover { border-color: #858585; color: white; }
			.markdown-output {
				max-height: min(190px, 25vh);
				overflow: auto;
				margin: 15px 0 0;
				padding: 13px 12px;
				border: 1px solid #292929;
				border-radius: 9px;
				background: #101010;
				color: #e2e2e2;
				font: 10px/1.8 ui-monospace, SFMono-Regular, Consolas, monospace;
				white-space: pre-wrap;
				overflow-wrap: anywhere;
			}
			.markdown-output.placeholder { color: #777777; }
			.calendar-panel { display: flex; flex-direction: column; padding: 26px 24px 20px; }
			.calendar-header {
				width: 100%;
				max-width: min(620px, 78vh);
				margin: 0 auto 25px;
				justify-content: space-between;
			}
			.calendar-header h2 { margin: 0; font-size: 23px; font-weight: 650; letter-spacing: -.045em; text-transform: capitalize; }
			.month-controls { display: flex; align-items: center; justify-content: flex-start; gap: 8px; width: auto; }
			.month-controls select, .year-select {
				height: 32px;
				border: 0;
				border-bottom: 1px solid #494949;
				border-radius: 0;
				background: transparent;
				color: #ededed;
				font-size: 11px;
			}
			.month-controls select { width: 112px; padding: 0 3px; }
			.month-controls select option { background: #111111; color: #ffffff; }
			.year-select { width: 58px; padding: 0 3px; text-align: center; }
			.calendar-navigation { display: flex; align-items: center; gap: 5px; margin-left: auto; }
			.icon-button {
				display: grid;
				place-items: center;
				width: 34px;
				height: 34px;
				border: 1px solid transparent;
				border-radius: 9px;
				background: transparent;
				color: #aaaaaa;
				cursor: pointer;
			}
			.icon-button:hover { border-color: #343434; background: #202020; color: white; }
			.icon-button svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
			.weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
			.weekdays { gap: 6px; margin-bottom: 12px; }
			.weekdays span { padding: 9px 0; color: #818181; text-align: center; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
			.weekdays, .calendar-grid { width: 100%; max-width: min(620px, 78vh); margin-inline: auto; }
			.calendar-grid { gap: 6px; }
			.day-cell {
				position: relative;
				display: flex;
				min-width: 0;
				aspect-ratio: 1 / 1;
				align-items: center;
				justify-content: center;
				border: 1px solid #393939;
				border-radius: 11px;
				background: #1d1d1d;
				color: #c7c7c7;
				font-size: 14px;
				font-weight: 500;
				cursor: pointer;
				transition: background .16s, border-color .16s, color .16s;
			}
			button.day-cell:hover { border-color: #777777; background: #303030; color: white; }
			.day-cell.empty-cell { border-color: transparent; background: transparent; cursor: default; }
			.day-cell.selected { border-color: #ffffff; background: #292929; color: #ffffff; font-weight: 750; }
			.day-cell.marked { border-color: #ffffff; background: #ffffff; color: #000000; font-weight: 700; }
			.day-cell.marked.selected { border-color: #a8a8a8; background: #ffffff; color: #000000; }
			.day-cell.marked:hover { background: #dedede; }
			.day-cell.marked.selected:hover { background: #dedede; }
			.day-cell.sunday { outline: 1px solid #d65a5a; outline-offset: -3px; }
			.day-cell.today { box-shadow: inset 0 0 0 1px currentColor; }
			.day-dot {
				position: absolute;
				bottom: 13%;
				left: 50%;
				width: 5px;
				height: 5px;
				transform: translateX(-50%);
				border-radius: 50%;
				background: #000000;
			}
			.day-cell.marked.selected .day-dot { background: #000000; }
			.today-dot {
				position: absolute;
				bottom: 13%;
				left: 50%;
				width: 5px;
				height: 5px;
				transform: translateX(-50%);
